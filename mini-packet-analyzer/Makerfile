CC = gcc

CFLAGS = -Wall -Wextra -std=c11 -Iinclude

TARGET = packet_analyzer

SRC = main.c 
src/error.c 
src/input.c 
src/packet.c 
src/parser.c 
src/serialize.c 
src/storage.c 
src/validation.c

OBJ = $(SRC:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJ)
$(CC) $(CFLAGS) $(OBJ) -o $(TARGET)

%.o: %.c
$(CC) $(CFLAGS) -c $< -o $@

clean:
rm -f $(OBJ) $(TARGET)

run: $(TARGET)
./$(TARGET)

.PHONY: all clean run
